{
  "name": "meter402",
  "version": "0.1.1",
  "description": "Per-second metered & streaming settlement for x402 — pay-as-you-consume billing, signed receipts, and an on-chain verifier that re-derives every total from the chain.",
  "type": "module",
  "license": "MIT",
  "author": "Oluwasogo \"Israel\" Ajala (Rising Technology)",
  "homepage": "https://github.com/Risingtell/meter402",
  "repository": { "type": "git", "url": "https://github.com/Risingtell/meter402.git" },
  "keywords": [
    "x402", "payments", "micropayments", "streaming", "metering", "pay-per-use",
    "ai-agents", "agent-economy", "mcp", "settlement", "usdc"
  ],
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./express": { "types": "./dist/express.d.ts", "import": "./dist/express.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" },
    "./verify": { "types": "./dist/verify.d.ts", "import": "./dist/verify.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "example:server": "tsx examples/server.ts",
    "verify:evm": "tsx scripts/verify-evm.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "express": "^4.19.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=18" }
}
